# Copie para .env e ajuste se quiser outras credenciais.
# O docker compose lê o .env automaticamente; para a aplicação, exporte as mesmas
# variáveis no terminal ou na configuração de execução da IDE.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biblioteca_virtual
DB_USERNAME=biblioteca
DB_PASSWORD=biblioteca
DB_ROOT_PASSWORD=root

# Autenticação: chave dos tokens JWT (mínimo 32 caracteres) e o bibliotecário criado na primeira subida
JWT_SECRET=troque-por-uma-frase-longa-e-secreta-com-32-ou-mais-caracteres
ADMIN_MATRICULA=admin
ADMIN_SENHA=admin123
